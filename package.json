{
	"name": "sol-omp",
	"version": "0.1.0",
	"description": "OMP-native context and tool-efficiency extensions",
	"type": "module",
	"private": true,
	"files": [
		"src/sol-omp",
		"assets",
		"docs/compatibility.md",
		"docs/configuration.md",
		"scripts/check-sol-omp-config.mjs",
		"scripts/check-sol-omp-compat.mjs",
		"scripts/check-compatibility-watch.mjs",
		"agents-install.md",
		"README.md",
		"LICENSE",
		"CONTRIBUTING.md",
		"SECURITY.md",
		"THIRD_PARTY_NOTICES.md",
		"sol-omp.example.json"
	],
	"scripts": {
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"check": "bun run typecheck && bun test && bun pm pack --dry-run",
		"compat": "bun scripts/check-sol-omp-compat.mjs",
		"compat:watch": "node scripts/check-compatibility-watch.mjs"
	},
	"keywords": [
		"omp-package",
		"omp-extension",
		"context-management"
	],
	"omp": {
		"extensions": [
			"./src/sol-omp/index.ts"
		]
	},
	"peerDependencies": {
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@oh-my-pi/pi-agent-core": "18.2.6",
		"@oh-my-pi/pi-ai": "18.2.6",
		"@oh-my-pi/pi-coding-agent": "18.2.6",
		"@oh-my-pi/pi-tui": "18.2.6",
		"@types/node": "24.12.4",
		"typebox": "1.3.7",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"overrides": {
		"nanoid": "3.3.18",
		"postcss": "8.5.26",
		"protobufjs": "7.6.5"
	},
	"license": "MIT"
}
